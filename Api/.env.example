DATABASE_URL=postgres://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BASE
# Base exclusiva para pruebas de integración. Nunca apuntar a producción.
TEST_DATABASE_URL=
# Opcional: usuario owner/superuser solo para ejecutar migraciones.
MIGRATION_DATABASE_URL=
# Pool de PostgreSQL. Ajustar DB_POOL_MAX a la capacidad del servidor.
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
JWT_ACCESS_SECRET=change-me-access-secret-local
JWT_REFRESH_SECRET=change-me-refresh-secret-local
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_CLIENT_ID=

# Email transaccional (Resend). RESEND_FROM_EMAIL debe pertenecer a un dominio verificado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_FROM_NAME=Tinku

# Códigos de verificación y recuperación
AUTH_CODE_PEPPER=change-me-with-a-long-random-secret
AUTH_CODE_TTL_MINUTES=15
AUTH_CODE_RESEND_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_MAX_REQUESTS_PER_HOUR=5
AUTH_CODE_MAX_REQUESTS_PER_IP_HOUR=20
# Sólo para desarrollo local. Nunca habilitar en producción.
AUTH_EXPOSE_CODES=false
# Optional local fixtures: npm run seed -- --test-users. Never use in production.
SEED_TEST_PASSWORD=

PORT=3003
NODE_ENV=development
# Proxy inverso confiable para obtener la IP real (Nginx local: loopback).
TRUST_PROXY=loopback
# Orígenes web autorizados, separados por coma. Las apps nativas no envían Origin.
# En producción no se agregan localhost automáticamente.
# Extra origins for local/temporary clients. The production web origin is read from ../config/domains.json.
CORS_ALLOWED_ORIGINS=
# Límites por IP. El endpoint /health/live no consume el límite global.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=40
FIREBASE_ADMIN_KEY_B64=
FIREBASE_STORAGE_BUCKET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SYSTEM_REVIEWER_ID=
STRIPE_DEFAULT_CURRENCY=BOB

API_SLOW_REQUEST_MS=500
API_LOG_REQUESTS=false
